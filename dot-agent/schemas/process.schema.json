{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "process.schema.json",
  "title": "Process definition（方法论定义）",
  "type": "object",
  "additionalProperties": false,
  "required": ["process_version", "name", "phases"],
  "properties": {
    "process_version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "artifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[A-Za-z0-9._-]+$" },
          "no": { "type": "string", "maxLength": 8 },
          "icon": { "type": "string", "maxLength": 8 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "intent": { "type": "string", "maxLength": 280 },
          "what": { "type": "string", "maxLength": 400 },
          "why": { "type": "string", "maxLength": 400 },
          "skills": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "inputs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "name", "path"],
              "properties": {
                "key": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[A-Za-z0-9._-]+$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "desc": { "type": "string", "maxLength": 280 },
                "path": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          },
          "depends_on": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
          "worklist": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "name"],
              "properties": {
                "key": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[A-Za-z0-9._-]+$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "desc": { "type": "string", "maxLength": 280 }
              }
            }
          },
          "gates": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 280 } },
          "dod": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 280 } },
          "artifacts": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "name", "path"],
              "properties": {
                "key": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[A-Za-z0-9._-]+$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "desc": { "type": "string", "maxLength": 280 },
                "path": { "type": "string", "minLength": 1, "maxLength": 200 },
                "required": { "type": "boolean" },
                "skills": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
              }
            }
          }
        }
      }
    },
    "rails": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[A-Za-z0-9._-]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "desc": { "type": "string", "maxLength": 280 }
        }
      }
    }
  }
}
