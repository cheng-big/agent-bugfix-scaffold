{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bug.schema.json",
  "title": "Bug 台账条目",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "唯一编号" },
    "title": { "type": "string", "minLength": 1, "description": "现象/标题" },
    "repro": { "type": "string", "description": "复现步骤" },
    "expected": { "type": "string", "description": "期望行为" },
    "actual": { "type": "string", "description": "实际行为" },
    "severity": { "type": "string", "description": "严重级/优先级（如 P0/P1/P2/高）" },
    "module": { "type": "string", "description": "所属模块" },
    "page": { "type": "string", "description": "所属页面" },
    "platform": { "type": "string", "description": "涉及端（web/小程序/云函数），或模块/页面组合" },
    "status": { "type": "string", "description": "状态（待修复/待开发/待确认…；已验收/已完成等在录入时被过滤）" },
    "reporter": { "type": "string", "description": "提出人/报告人" },
    "raw": { "type": "object", "description": "原始列全量留存，AI 再补" }
  }
}
